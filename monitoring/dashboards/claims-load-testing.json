      "fieldConfig": {
        "defaults": { "unit": "percent" }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container=\"claims-ingestion\"}) / sum(kube_pod_container_resource_limits{resource=\"memory\", container=\"claims-ingestion\"}) * 100",
          "legendFormat": "Claims Ingestion Memory %",
          "refId": "A"
        }
      ]
