<!--
================================================================================
GLOBAL INBOUND APIM POLICY: Healthcare Multi-Tenant Zero Trust Policy
Enforces TLS 1.3, Global Correlation ID, and Application Insights Telemetry
================================================================================
-->
<policies>
    <inbound>
        <base />
        <!-- 1. Enforce Correlation ID across all incoming requests -->
        <choose>
            <when condition="@(!context.Request.Headers.ContainsKey(&quot;X-Correlation-ID&quot;))">
                <set-header name="X-Correlation-ID" exists-action="override">
                    <value>@(Guid.NewGuid().ToString())</value>
                </set-header>
            </when>
        </choose>

        <!-- 2. Set backend request tracking headers -->
        <set-header name="X-Forwarded-By" exists-action="override">
            <value>Azure-APIM-Healthcare-Gateway</value>
        </set-header>

        <!-- 3. Emit W3C distributed trace context -->
        <trace source="HealthcareAPIMGateway" severity="information">
            <message>@("Inbound Request received for path: " + context.Request.Url.Path + ", CorrelationId: " + context.Request.Headers.GetValueOrDefault("X-Correlation-ID"))</message>
            <metadata name="CorrelationId" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;))" />
            <metadata name="ClientIP" value="@(context.Request.IpAddress)" />
        </trace>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <!-- Echo Correlation ID in response headers for client tracking -->
        <set-header name="X-Correlation-ID" exists-action="override">
            <value>@(context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;))</value>
        </set-header>
        <!-- Security response headers -->
        <set-header name="X-Content-Type-Options" exists-action="override">
            <value>nosniff</value>
        </set-header>
        <set-header name="X-Frame-Options" exists-action="override">
            <value>DENY</value>
        </set-header>
        <set-header name="Strict-Transport-Security" exists-action="override">
            <value>max-age=31536000; includeSubDomains; preload</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
        <set-header name="X-Correlation-ID" exists-action="override">
            <value>@(context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;))</value>
        </set-header>
    </on-error>
</policies>
